normalization1 = normalization([0.0, 0.0, 0.0], [255.0, 255.0, 255.0])
change_output_activation(conv48, sigmoid)
change_output_activation(conv59, sigmoid)
change_output_activation(conv69, sigmoid)
model_optimization_flavor(optimization_level=0)
nms_postprocess("../../postprocess_config/yolov10n_nms_config.json", meta_arch=yolov8, engine=cpu)

context_switch_param(partitioner=slottest)
context_switch_param(unikorn_cluster_pass_probability=0.4)
context_switch_param(unikorn_single_cluster=true)
context_switch_param(slottest_accuracy_level=3)
context_switch_param(slottest_shmifo_overflow=0)
context_switch_param(slottest_splitter_topk=5)
context_switch_param(slottest_use_funks=true)
allocator_param(enable_fixer=max_adjcents, layer_inputs_use_single_shmifo=true)