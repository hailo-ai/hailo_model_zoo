quantization_param({concat*}, precision_mode=a16_w16)
quantization_param([conv50, conv58, conv61, conv63, conv71, conv75, conv77], precision_mode=a16_w16)
pre_quantization_optimization(matmul_correction, layers={matmul*}, correction_type=zp_comp_block_3)
