norm1 = normalization([122.7709383, 116.7460125, 104.09373615000001], [68.5005327, 66.6321579, 70.32316304999999])
pre_quantization_optimization(decompose_conv_factor, policy=enabled)
pre_quantization_optimization(smart_softmax_stats, optimize_bias=enabled, optimize_bias_algorithm=ZERO_MIDPOINT, force_zero_centered=True)
pre_quantization_optimization(activation_clipping, layers=[conv_feature_splitter23_1], mode=percentile, clipping_values=[0, 99.95], recollect_stats=True)
model_optimization_flavor(optimization_level=0, compression_level=0)
model_optimization_config(calibration, batch_size=1, calibset_size=64)
model_optimization_config(negative_exponent, layers={*}, rank=0)

quantization_param([slice1], precision_mode=a16_w16)
quantization_param({ew_add*}, precision_mode=a16_w8)
quantization_param({norm*}, precision_mode=a16_w8)
quantization_param([conv1_s2d, concat1, format_conversion1], precision_mode=a16_w16)
quantization_param([conv1], precision_mode=a16_w8)
quantization_param([conv53, conv98], precision_mode=a16_w8)

conv53_d0, conv53_d1, conv53_d2, conv53_d3, conv53_dc = defuse(conv53, 4)
conv98_d0, conv98_d1, conv98_d2, conv98_d3, conv98_dc = defuse(conv98, 4)

resources_param(max_memory_utilization=0.5)
context_switch_param(slotter_chances=10000, mode=enabled, toposort_mode=pushdown, share_buckets_partition=True, auto_partition_to_buckets=True, berkitizer_min_size=200, berkitizer_bucket_size=30)
performance_param(optimize_for_batch=1, compiler_optimization_level=0)
compilation_param({*}, enable_nested_defuse=True)

# finetune required to recover NV12 input-conversion degradation on hailo15l
post_quantization_optimization(finetune, policy=enabled, epochs=16, learning_rate=0.00001, batch_size=1)
